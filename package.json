{
  "name": "habita-studio",
  "version": "0.9.0",
  "description": "Editor local de casas en 2D y 3D",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --base=./",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:e2e": "npm run build && electron tests/ha-e2e.cjs",
    "lab": "node tools/lab/fake-home-assistant.cjs",
    "desktop": "npm run build && electron .",
    "pack:win": "npm run build && node node_modules/electron/install.js && electron-builder --win --publish never --config.electronDist=node_modules/electron/dist"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "cl.habita.studio",
    "productName": "Habita Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Habita Studio",
      "artifactName": "Habita-Studio-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Habita-Studio-${version}.exe"
    }
  }
}
