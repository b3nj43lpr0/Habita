{
  "name": "habita-studio",
  "version": "0.1.6",
  "description": "Editor local de casas en 2D y 3D",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build --base=./",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "desktop": "npm run build && electron .",
    "pack:win": "npm run build && node node_modules/electron/install.js && electron-builder --win portable --config.electronDist=node_modules/electron/dist"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "cl.habita.studio",
    "productName": "Habita Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Habita-Studio-${version}.exe"
    }
  }
}
